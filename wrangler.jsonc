/**
 * Cloudflare is the execution/MCP layer only.
 * Application persistence is GitHub-only under keywayk09/tv-papertrader main/data; D1 and R2 are forbidden for app data.
 * OAUTH_KV is ephemeral OAuth/session state owned by @cloudflare/workers-oauth-provider; it is not application market-data persistence.
 * OHLC/K-line remains owned by the existing tv-fugle-1d canonical pipeline even though taistock-mcp reads the canonical GitHub files directly.
 * Durable Object lifecycle uses declarative exports; production deploys must use `wrangler deploy`.
 * Existing MyMCP/FamilyMCP namespaces are preserved as live exports; deletion tombstones are forbidden without explicit review.
 * Cloudflare Service Bindings are same-account only. taistock-mcp therefore uses read-only Fugle REST for stock realtime and GitHub canonical reads for formal OHLC; no cross-account Worker binding is configured.
 * Crypto is read from the separate central tv-crypto-engine over its public read-only HTTPS surface; no duplicate crypto engine is deployed here.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taistock-mcp",
	"main": "src/index-v6.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"RESEARCH_MAX_SYMBOLS": "40",
		"RESEARCH_MAX_ONE_MINUTE": "8",
		"GITHUB_DATA_REPO": "keywayk09/tv-papertrader",
		"GITHUB_DATA_BRANCH": "main",
		"CRYPTO_ENGINE_BASE_URL": "https://tv-crypto-engine.keikei99887.workers.dev"
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV"
		}
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"exports": {
		"MyMCP": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"FamilyMCP": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			},
			{
				"class_name": "FamilyMCP",
				"name": "FAMILY_MCP_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
