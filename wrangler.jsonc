/**
 * Cloudflare is the execution and market-data layer.
 * Project policy: D1 only for Diamond persistence; R2 is forbidden.
 * OHLC/K-line remains owned by OHLC MCP.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taistock-mcp",
	"main": "src/index-v6.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"RESEARCH_MAX_SYMBOLS": "40",
		"RESEARCH_MAX_ONE_MINUTE": "8"
	},
	"triggers": {
		"crons": [
			"30 10 * * 1-5",
			"30 12 * * 1-5"
		]
	},
	"d1_databases": [
		{
			"binding": "DB"
		},
		{
			"binding": "RESEARCH_DB",
			"database_name": "taistock-research"
		}
	],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
