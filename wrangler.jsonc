/**
 * Production Cloudflare configuration.
 * Preserve OAuth KV, D1 and Durable Object bindings while adding the GitHub-only
 * Diamond Market Data V1 collector. No R2 binding is required.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taistock-mcp",
	"main": "src/market-data-production-entry.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"MARKET_DATA_GITHUB_REPO": "keywayk09/tv-papertrader",
		"MARKET_DATA_GITHUB_BRANCH": "main"
	},
	"triggers": {
		"crons": [
			"40 7 * * 1-5",
			"10 9 * * 1-5",
			"10 10 * * 1-5",
			"10 12 * * 1-5",
			"10 13 * * 1-5",
			"30 13 * * 1-5",
			"10 14 * * 1-5",
			"30 14 * * 1-5"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "taistock-mcp-db",
			"database_id": "18673f52-c286-49f3-a82c-bf67d0593611"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "7421664843414cd584f772f9ddd53670"
		}
	],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["FamilyMCP"],
			"tag": "v2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			},
			{
				"class_name": "FamilyMCP",
				"name": "FAMILY_MCP_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
