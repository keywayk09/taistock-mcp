/**
 * Cloudflare is the execution and market-data layer.
 * Project policy: D1 only for Diamond persistence; R2 is forbidden.
 * OHLC/K-line remains owned by OHLC MCP.
 * Durable Object lifecycle uses declarative exports; production deploys must use `wrangler deploy`.
 * Existing Durable Object namespaces are preserved as live exports; deletion tombstones are forbidden without explicit review.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taistock-mcp",
	"main": "src/index-v6.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"RESEARCH_MAX_SYMBOLS": "40",
		"RESEARCH_MAX_ONE_MINUTE": "8"
	},
	"triggers": {
		"crons": [
			"30 10 * * 1-5",
			"30 12 * * 1-5",
			"*/5 17-18 19 8 *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB"
		},
		{
			"binding": "RESEARCH_DB",
			"database_name": "taistock-research"
		}
	],
	"exports": {
		"MyMCP": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"FamilyMCP": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			},
			{
				"class_name": "FamilyMCP",
				"name": "FAMILY_MCP_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
