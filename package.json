{
	"name": "taistock-mcp",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "oxfmt --write .",
		"lint:fix": "oxlint --fix",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"type-check": "tsc --noEmit",
		"test:safe-crawler": "rm -rf .tmp-safe-crawler && tsc -p tsconfig.safe-crawler-test.json && node --test tests/safe-crawler.test.cjs",
		"audit:security": "npm audit --audit-level=moderate"
	},
	"dependencies": {
		"agents": "^0.20.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"typescript": "6.0.3",
		"wrangler": "^4.114.0"
	},
	"overrides": {
		"undici": "7.29.0"
	}
}
